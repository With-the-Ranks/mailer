# DON'T FORGET TO RENAME TO .env OR .env.local BEFORE PUSHING TO GIT

### DEVELOPMENT ONLY VARIABLES
# These variables need to be set for local development only

# Mandatory next-auth URL for localhost
NEXTAUTH_URL=http://app.localhost:3000
 
### PRODUCTION & DEVELOPMENT VARIABLES
# These variables need to be set for local development and when deployed on Vercel

# Change this to your own domain
NEXT_PUBLIC_ROOT_DOMAIN=localhost

# PostgreSQL database URL – get one here: https://vercel.com/docs/storage/vercel-postgres/quickstart
#
# LOCAL DEVELOPMENT: Prisma's driver requires an explicit username and 127.0.0.1 (not `localhost`,
# which resolves to IPv6 on Linux/macOS and may not match pg_hba.conf trust rules).
# Replace YOUR_DB_USER with your OS username (run `whoami` to check). See README instructions to handle
# this automatically.
#
#   DATABASE_URL=postgresql://YOUR_DB_USER@127.0.0.1/mailer
#   DATABASE_URL_UNPOOLED=postgresql://YOUR_DB_USER@127.0.0.1/mailer
#
# PRODUCTION (Vercel Postgres or similar): use the connection string from your provider.
DATABASE_URL=postgresql://YOUR_DB_USER@127.0.0.1/mailer
DATABASE_URL_UNPOOLED=postgresql://YOUR_DB_USER@127.0.0.1/mailer

# Vercel Blob Storage for image uploads – currently in beta, please fill out this form for access: https://tally.so/r/nPDMNd. Setup instructions: https://vercel.com/docs/storage/vercel-blob/quickstart
BLOB_READ_WRITE_TOKEN=

# Secrets for auth & login
# Generate a secure random secret for production, for example:
#   openssl rand -base64 32
# Do NOT commit real secrets to version control; set this in your local .env/.env.local
NEXTAUTH_SECRET=

# Only required for GitHub authentication – get these by creating an OAuth app here: https://github-client-generator.vercel.app/
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Vercel authentication token that can be found here: https://vercel.com/account/tokens
AUTH_BEARER_TOKEN=
# Vercel Project ID that can be found here: https://vercel.com/<org>/<project>/settings
PROJECT_ID_VERCEL=
# Vercel Team ID that can be found here: https://vercel.com/teams/<org>/settings
# Only required if you're using this with a Vercel team
TEAM_ID_VERCEL=


# ===========================================
# Email Provider Configuration
# ===========================================

# Email provider configuration
# Options:
#   ses     = Amazon SES (domains management in Settings > Domains)
#   resend  = Resend (API key and sending domain in Settings > Domains)
#   console = Log emails to the console (recommended for local development)
# For production, set this to either "ses" or "resend".
DEFAULT_EMAIL_PROVIDER=console

# Default email domain (used when no organization domain is configured)
EMAIL_DOMAIN=

# ===========================================
# Redis Configuration (REQUIRED for email queue)
# ===========================================

# Redis connection URL for BullMQ email queue
# Local: redis://localhost:6379
# Upstash: rediss://default:xxx@xxx.upstash.io:6379
REDIS_URL=redis://localhost:6379

# Optional bearer token for /api/cron/email-queue
CRON_SECRET=

# ===========================================
# AWS SES Configuration (REQUIRED when DEFAULT_EMAIL_PROVIDER=ses)
# ===========================================

# AWS IAM credentials with SES/SNS permissions
# Required permissions: ses:SendEmail, ses:SendRawEmail, sns:Subscribe, sns:ConfirmSubscription
# Note: AWS_SECRET_KEY is reserved on Vercel - use these SES-specific names instead
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# AWS region for SES (default: us-east-1)
AWS_DEFAULT_REGION=us-east-1

# SES Configuration Set name for event tracking (bounces, complaints, deliveries, opens, clicks)
# Create this in AWS SES Console > Configuration Sets
AWS_SES_CONFIG_SET=mailer-events

# ===========================================
# Resend Configuration (only when DEFAULT_EMAIL_PROVIDER=resend)
# ===========================================

# Resend API key – get one here: https://resend.com/api-keys
RESEND_API_KEY=
